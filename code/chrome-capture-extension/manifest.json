{
  "manifest_version": 3,
  "name": "Nexus Capture",
  "version": "1.0.0",
  "description": "Passively captures claude.ai conversations and sends them to a self-hosted Nexus server.",

  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://nexus.needpedia.org/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"]
    }
  ],

  "options_page": "options.html"
}
